pkgbase = update-anything
	pkgdesc = Update every package manager actually installed, on any Unix, without assuming any of them are present
	pkgver = 1.1.0
	pkgrel = 1
	url = https://github.com/legeeknumero1/update-anything
	arch = any
	license = GPL-3.0-or-later
	checkdepends = shellcheck
	depends = bash
	optdepends = sudo: required by every package manager that needs root
	optdepends = curl: connectivity pre-flight check (falls back to wget, then /dev/tcp)
	optdepends = pacman-contrib: preview pending pacman updates before applying them
	optdepends = arch-audit: --audit, a CVE check against installed packages
	optdepends = needrestart: list services still running outdated libraries after an update
	optdepends = fwupd: --firmware, firmware updates via fwupdmgr
	optdepends = snapper: --snapshot, a filesystem snapshot before updating
	optdepends = timeshift: --snapshot, an alternative snapshot backend
	optdepends = networkmanager: warn before downloading over a metered connection
	source = update-anything-1.1.0.tar.gz::https://github.com/legeeknumero1/update-anything/archive/refs/tags/v1.1.0.tar.gz
	sha256sums = 84789fa9bfe956e2417ef1233ec0618bc440f62a8113e6d8af38be0e0090b957

pkgname = update-anything
